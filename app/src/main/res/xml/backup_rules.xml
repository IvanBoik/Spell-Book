<?xml version="1.0" encoding="utf-8"?><!--
   Правила автобэкапа для Android 11 и ниже.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Токены аккаунта зашифрованы ключом Keystore, который на другое устройство
         не переносится: восстановленный токен там нечем было бы расшифровать. -->
    <exclude domain="sharedpref" path="spellbook_auth.xml" />
</full-backup-content>
