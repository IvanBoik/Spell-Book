<?xml version="1.0" encoding="utf-8"?><!--
   Правила резервного копирования и переноса данных для Android 12+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Токены аккаунта зашифрованы ключом Keystore, который не переносится между
         устройствами, поэтому файл с ними не копируется ни в облако, ни при переносе. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="spellbook_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="spellbook_auth.xml" />
    </device-transfer>
</data-extraction-rules>
